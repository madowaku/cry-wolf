{
  "name": "cry-wolf-romantic",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5193 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "qa:routes": "vitest run tests/routes.test.ts --reporter=verbose",
    "music:pack": "node scripts/pack-storybook-music.mjs && node scripts/moon/sync-storybook-audio.mjs",
    "music:moon": "node scripts/moon/sync-storybook-audio.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5195 --strictPort"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
